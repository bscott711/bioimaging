[Unit]
Description=opym-backfill: continuous OPM backfill discovery (watch mode)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/science/bioimaging
Environment=OPYM_BACKFILL_REGISTRY_PATH=/mmfs2/scratch/SDSMT.LOCAL/bscott/opym_backfill/registry.sqlite3
# Decon is opt-in. OPYM_DECON_PSF comes from the one file opym-receive.service
# also reads (installed from deploy/opym-decon.env), so the two cannot disagree;
# it replaces the former --decon-psf flag, which only set this same variable
# in-process (opym.decon_config.resolve_decon_psf reads it either way). The file
# has no leading "-", so a missing file stops the unit instead of silently
# running deskew-only.
EnvironmentFile=%h/.config/systemd/user/opym-decon.env
# Named z step for stores that ship without their own `z` coordinate array (an
# interrupted or still-transferring acquisition). pipeline.py refuses to guess
# by default rather than deskew at a silently wrong scale; 0.3 (the
# OPYM_ZARR_ALLOW_DEFAULT_Z_STEP fallback) is wrong for every dataset in this
# corpus, which is 0.1 or 0.5. 0.5 is what every sibling of 20260917/Cell_007 --
# the dataset this was added for -- measures from its own store. This applies to
# ANY store missing its z array, not just that one; the backfill log reports the
# source per dataset, so revisit if an acquisition at a different step lands
# incomplete.
Environment=OPYM_ZARR_DEFAULT_Z_STEP=0.5
# Priority lanes (opym.lanes): at most this many backfill tickets queued or
# running at once, 2 per GPU server so neither idles between tickets. Tickets
# are then built shortly before they run, with current decon params, not days
# ahead (on 2026-09-24, 36 queued tickets carried params superseded 3 days
# earlier). Passes also pause entirely while a live acquisition holds the lease.
Environment=OPYM_BACKFILL_MAX_INFLIGHT=4
# Without this, print() to a file is block-buffered and the log lags.
Environment=PYTHONUNBUFFERED=1
# Transparent huge pages: numpy madvises every array over 4 MB for huge pages,
# and with this host's THP defrag=madvise each first touch of one can stall in
# direct compaction (measured 2026-09-26: 30 GB of 127 MB arrays took 101 s,
# single allocations up to 1.9 s, vs 15 s with this set). Opt out; naparym-live
# does the same in-process (opym.live_view.no_hugepage_stalls).
Environment=NUMPY_MADVISE_HUGEPAGE=0
# Run the venv script, not `uv run`: `uv run` re-syncs the production .venv on every
# (re)start. A dependency change needs an attended `uv sync` instead.
ExecStart=%h/projects/science/bioimaging/.venv/bin/opym-backfill --watch 120
Restart=on-failure
RestartSec=10
# journalctl --user is not readable on this host (see opym-receive.service).
StandardOutput=append:%h/projects/science/bioimaging/logs/opym-backfill.log
StandardError=append:%h/projects/science/bioimaging/logs/opym-backfill.log

[Install]
WantedBy=default.target
