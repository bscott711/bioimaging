[Unit]
Description=opym-receive: real-time frame-streaming ingress (opym.stream)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/bioimaging
# MUST match opym-backfill.service's own `--decon-psf` flag (which sets
# this same env var in-process -- see run_backfill_cli.py -- but only for
# ITS OWN process; opym-receive is a separate service and does not inherit
# it). If the two ever disagree, the receiver's pre-staged decon_stage/
# TIFFs and the batch pass's decon-vs-deskew-only decision will disagree
# too -- see opym.stream.receiver's module docstring. Leave unset (or
# empty) to match a deskew-only backfill (no --decon-psf).
Environment=OPYM_DECON_PSF=/mmfs2/scratch/SDSMT.LOCAL/bscott/DataUpload/PSF/20260910_averaged_psf.tif
# The backfill's status registry -- MUST match opym-backfill.service's own
# OPYM_BACKFILL_REGISTRY_PATH. When a new run reuses a name, the receiver
# moves the earlier run to <folder>/.superseded/ and forgets it here, so the
# reused name isn't counted as already processed (opym.stream.receiver
# _supersede). Unset, that earlier run is still moved but stays "done" here,
# and the backfill would skip the new run.
Environment=OPYM_BACKFILL_REGISTRY_PATH=/mmfs2/scratch/SDSMT.LOCAL/bscott/opym_backfill/registry.sqlite3
# RAM-disk staging (opt-in, unset = write straight to each session's
# declared raw_root on GPFS, today's original behavior). Set so PetaKit5D's
# deskew/decon reads with zero GPFS latency -- see
# opym.stream.receiver's module docstring and opym.stream.drain. A
# background DrainPool copies each completed session to GPFS, verified
# byte-for-byte, so GPFS stays the durable system of record; tmpfs is
# volatile and only ever a staging copy of what a session already landed
# on GPFS via this drain.
Environment=OPYM_STREAM_STAGE_ROOT=/dev/shm/opym_stream_stage
# Live lane (opym.stream.live): decon -> deskew/rotate each streamed timepoint
# as soon as all of its channels have landed, on the GPUs' live queue, ahead
# of the backfill (the receiver holds LIVE_LEASE.json while it has live work).
# Needs OPYM_DECON_PSF above. Output lands in the dataset's final DSR dir on
# GPFS; the backfill takes over from .live_status.json there.
Environment=OPYM_LIVE_LANE=1
# Live QC (opym.stream.qcproj): write projections of every staged raw frame to
# the dataset's <leaf>/qc/rawproj/ for opym-live-qc.service, and forward its
# verdicts to clients that ask for them (MSG_QC). Off, or with the QC service
# stopped, acquisitions stream exactly as before.
Environment=OPYM_LIVE_QC=1
# One-format live lane (opym.stream.live_zarr): decon + deskew/rotate run
# entirely in memory and land in a processed OME-Zarr store on the RAM disk
# (bioformats2raw layout 3, real OME-XML) instead of the decon/DSR/MIP TIFF
# relay. Validated bit-identical to the TIFF path and proven end-to-end in
# an isolated replay (2026-09-25) before flipping this on in production.
# Unset (or not "zarr") keeps the TIFF lane, opym.stream.live.LiveLane.
Environment=OPYM_LIVE_FORMAT=zarr
# Transparent huge pages: numpy madvises every array over 4 MB for huge pages,
# and with this host's THP defrag=madvise each first touch of one can stall in
# direct compaction (measured 2026-09-26: 30 GB of 127 MB arrays took 101 s,
# single allocations up to 1.9 s, vs 15 s with this set). Opt out; naparym-live
# does the same in-process (opym.live_view.no_hugepage_stalls).
Environment=NUMPY_MADVISE_HUGEPAGE=0
ExecStart=%h/.local/bin/uv run opym-receive
Restart=on-failure
RestartSec=10
# journalctl --user is NOT readable on this host even by the service's own
# owning account (confirmed 2026-09-23: "No journal files were opened due
# to insufficient permissions" for bscott's own --user unit) -- true for
# every service here, not just this one. Redirect to a plain file instead
# so SESSION_START/SESSION_END/drain-queued/drained lines (the only way to
# confirm a streamed acquisition actually landed) are actually readable.
StandardOutput=append:%h/projects/bioimaging/logs/opym-receive.log
StandardError=append:%h/projects/bioimaging/logs/opym-receive.log

[Install]
WantedBy=default.target
