# The one source of OPYM_DECON_PSF for opym-backfill.service and opym-receive.service
# (both name it in EnvironmentFile=). Install next to the units:
#   cp deploy/opym-decon.env ~/.config/systemd/user/
# then restart both. The PSF is the 2026-09-10 averaged measured PSF. Leave the value
# empty (OPYM_DECON_PSF=) for deskew-only in both services.
# systemd syntax: KEY=value, no quotes or export, no %-specifiers needed here.
OPYM_DECON_PSF=/mmfs2/scratch/SDSMT.LOCAL/bscott/DataUpload/PSF/20260910_averaged_psf.tif
